rules_version = '2';

// Every participant signs in with their own Google account, so unlike a
// shared-secret scheme, request.auth is a real, per-person identity here -
// these rules are a genuine security boundary, not just a formality.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() &&
        exists(/databases/$(database)/documents/meta/config) &&
        request.auth.token.email in
          get(/databases/$(database)/documents/meta/config).data.adminEmails;
    }

    // Admins always count as participants (so they can vote too); everyone
    // else needs an invite that hasn't been blocked.
    function isActiveParticipant() {
      return isAdmin() || (
        signedIn() &&
        exists(/databases/$(database)/documents/members/$(request.auth.token.email)) &&
        get(/databases/$(database)/documents/members/$(request.auth.token.email)).data.status == 'active'
      );
    }

    match /meta/config {
      allow read: if signedIn();
      // Anyone signed in may create the config doc if it doesn't exist yet
      // (whoever sets up the contest first becomes the first admin); after
      // that, only an existing admin may change it (including adminEmails).
      allow create: if signedIn();
      allow update: if isAdmin();
    }

    match /contestants/{contestantId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /predictions/{predictionId} {
      allow read: if signedIn();
      // You may only ever write your own prediction - the doc id is your uid -
      // and only while you're an active (invited, non-blocked) participant.
      allow create, update: if signedIn() && request.auth.uid == predictionId && isActiveParticipant();
      allow delete: if isAdmin();
    }

    match /results/{resultId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Invite list: doc id is the invited email address.
    match /members/{email} {
      allow get: if signedIn() && (request.auth.token.email == email || isAdmin());
      allow list: if isAdmin();
      allow create, delete: if isAdmin();
      // Admins can change anything; an invited (not yet active, not blocked)
      // user may flip their own doc from 'invited' to 'active' the first
      // time they sign in - and nothing else, so a blocked user (whose
      // status is 'blocked', not 'invited') can never self-reactivate.
      allow update: if isAdmin() || (
        signedIn() &&
        request.auth.token.email == email &&
        resource.data.status == 'invited' &&
        request.resource.data.status == 'active' &&
        request.resource.data.email == resource.data.email
      );
    }

    // Archived snapshots of past contests, written when an admin resets for
    // a new season, so past submissions remain visible afterwards.
    match /seasons/{seasonId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
  }
}
